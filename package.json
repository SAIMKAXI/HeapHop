{
  "name": "heaphop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm test && npm run build && npm run webview:check && npm run e2e",
    "bench": "tsx scripts/bench.ts",
    "fixtures": "tsx scripts/fixtures-report.ts",
    "build:standalone": "node scripts/build-standalone.mjs",
    "webview:check": "node scripts/webview-check.mjs",
    "e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
