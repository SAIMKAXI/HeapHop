{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node", "vscode"],
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "paths": {
      "@/*": ["../src/*"],
      "@content/*": ["../content/*"]
    }
  },
  "include": ["src/**/*.ts", "webview/**/*.ts", "webview/**/*.tsx", "test/**/*.ts", "scripts/**/*.d.ts"]
}
